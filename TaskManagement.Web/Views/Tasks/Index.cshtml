@model IReadOnlyList<TaskDto>
@{
    ViewData["Title"] = "تسک‌های من";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>تسک‌های ایجادشده</h2>
    <a asp-action="Create" class="btn btn-primary">تسک جدید</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">هنوز تسکی نساخته‌اید.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>ردیف</th>
                    <th>عنوان</th>
                    <th>توضیحات</th>
                    <th>ایجادکننده</th>
                    <th>اختصاص به</th>
                    <th>تاریخ ایجاد</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr class="@(item.IsDeleted ? "task-deleted" : null)" data-task-id="@item.Id">
                        <td>@(i + 1)</td>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.CreatorName</td>
                        <td>@item.AssignedToName</td>
                        <td>@item.CreatedAt.ToPersianDateTime()</td>
                        <td class="task-status">
                            @if (item.IsDeleted)
                            {
                                <span class="badge task-deleted-badge">حذف‌شده</span>
                            }
                            else
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                        </td>
                        <td class="task-actions">
                            @if (!item.IsDeleted)
                            {
                                <div class="d-inline-flex gap-1 justify-content-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning btn-icon"
                                       data-bs-toggle="tooltip"
                                       data-bs-title="ویرایش"
                                       aria-label="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                                        </svg>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-danger btn-icon btn-delete-task"
                                            data-task-id="@item.Id"
                                            data-bs-toggle="tooltip"
                                            data-bs-title="حذف"
                                            aria-label="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تأیید حذف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                آیا شما از حذف این رکورد اطمینان دارید؟
            </div>
            <div class="modal-footer">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button"
                        class="btn btn-danger"
                        id="confirmDeleteBtn"
                        data-delete-url="@Url.Action("Delete", "Tasks")">
                    حذف
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tasks/index.js" asp-append-version="true"></script>
}
